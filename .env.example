# Copy this file to .env.local and fill in real values. NEVER commit .env.local
# or any file containing the service-role key.

# ---- Public browser values (safe to expose; NEXT_PUBLIC_*) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Older Supabase projects call this the anon key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Newer projects call it the publishable key; either variable works:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical site URL used by metadata, robots.txt and sitemap.xml:
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ---- SERVER ONLY (never prefix with NEXT_PUBLIC_) ----
# Bypasses RLS. Used only by API routes for scoring/admin operations.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated admin email allowlist. Required for /admin and admin APIs.
ADMIN_EMAILS=admin@example.com
