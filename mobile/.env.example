# NimCuet mobile — local environment.
# Copy to `.env.local` before running `npm run dev` or `npm run build`.
# Only VITE_* variables are exposed to the client. NEVER put the Supabase
# service-role key here (or anywhere in this app) — it bypasses RLS.

# Production API (the existing Next.js backend on Vercel).
VITE_API_BASE_URL=https://nimcet-eta.vercel.app

# Supabase project (same project as the website, reachable under RLS).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY
